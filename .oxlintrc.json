{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "unicorn",
    "oxc",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "restriction": "warn"
  },
  "rules": {
    "no-console": 0,
    "import/no-default-export": 0
  },
  "env": {
    "builtin": true
  }
}